# Copia este archivo como .env y completa los valores.
# Nunca subas el archivo .env al repositorio.

PORT=3000
NODE_ENV=development

# Cadena de conexión de MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/oma_digital

# Secreto para firmar sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Solo si la API está detrás de un proxy (Nginx, IIS, balanceador): número de saltos
# TRUST_PROXY=1

# Opcional: contraseña inicial para "npm run crear-admin" (si no, se genera una)
# ADMIN_PASSWORD=

# Dirección donde escucha el servidor (0.0.0.0 = toda la red)
# HOST=0.0.0.0

# HTTPS: si existen backend/certs/oma.crt y oma.key (npm run generar-certificado)
# se usa HTTPS automáticamente. Rutas personalizadas:
# HTTPS_CERT=C:\ruta\certificado.crt
# HTTPS_KEY=C:\ruta\clave.key
# HTTPS=0   (fuerza HTTP, solo para pruebas)

# Fuerza la cookie de sesión "Secure" (si un proxy hace HTTPS por delante)
# COOKIE_SECURE=1

# Carpeta del frontend compilado (por defecto ../frontend/dist)
# FRONTEND_DIST=
